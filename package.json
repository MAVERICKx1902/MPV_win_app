{
  "name": "mpv-win-app",
  "private": true,
  "version": "0.1.0",
  "description": "Frameless, macOS-styled media player UI prototype (React + Vite + Tailwind) built to be wrapped with Tauri 2.0 for Windows and Android.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "tauri": "tauri",
    "dev:win": "tauri dev",
    "dev:apk": "tauri android dev",
    "build:win": "tauri build",
    "build:apk": "tauri android build",
    "verify:mocks": "vite build --ssr scripts/verify-mocks.ts --outDir node_modules/.verify-mocks --logLevel error && node node_modules/.verify-mocks/verify-mocks.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "clsx": "^2",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
